# Used automatically by `vite build` (production mode) when no build-time
# environment variable overrides it (e.g. Render's own env var settings for
# the web static site). Without this, api/client.js falls back to the
# relative '/api' - fine for a same-origin deployment, but broken for the
# Capacitor Android app, which loads its bundled UI from a fixed local
# origin (https://localhost) with no backend at that path. See
# src/api/client.js.
VITE_API_BASE_URL=https://rsa-construction-mobile-view.onrender.com/api
